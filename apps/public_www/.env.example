# Public Website environment template
#
# Copy to `.env.local` for local development. Production values are sourced
# from the GitHub Environment (`production`/`staging`) variables/secrets in
# .github/workflows/{deploy,promote}-public-www.yml.

# Absolute origin the site is served from. Used by canonical URLs, sitemap,
# robots, and structured data. Localhost is allowed in dev only.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Brand-level settings reused across copy and metadata.
NEXT_PUBLIC_SITE_NAME=Siu Tin Dei
NEXT_PUBLIC_SITE_TAGLINE=Curated children's activities in Hong Kong.

# Public contacts. Same values as build-env.defaults.json. Used by the
# full site and the maintenance holding page.
NEXT_PUBLIC_EMAIL=hello@siutindei.com
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/85294460861
NEXT_PUBLIC_INSTAGRAM_URL=

# When the staging CloudFront alias serves the site, the deploy script forces
# a deny-all robots.txt and the CloudFront response headers policy adds an
# X-Robots-Tag noindex header. The badge below is purely cosmetic.
NEXT_PUBLIC_STAGING_BADGE_ENABLED=false

# Staging search fixture (staging GitHub Environment var STAGING_SEARCH_DATA_ENABLED
# only; production builds always use the live search API). When true, listings
# load from {NEXT_PUBLIC_SITE_ORIGIN}/fixtures/activity_search_staging.json
# unless NEXT_PUBLIC_STAGING_SEARCH_FIXTURE_URL overrides.
NEXT_PUBLIC_STAGING_SEARCH_DATA_ENABLED=false
NEXT_PUBLIC_STAGING_SEARCH_FIXTURE_URL=

# Live search API (required when NEXT_PUBLIC_STAGING_SEARCH_DATA_ENABLED=false).
# NEXT_PUBLIC_DEVICE_ATTESTATION_TOKEN is the static website credential
# (GitHub secret CDK_PARAM_PUBLIC_WWW_ATTESTATION_TOKEN). It is not a Firebase
# App Check JWT. CloudFront adds X-Origin-Verify; do not put that secret here.
NEXT_PUBLIC_SEARCH_API_BASE_URL=
NEXT_PUBLIC_SEARCH_API_KEY=
NEXT_PUBLIC_DEVICE_ATTESTATION_TOKEN=

# Injected at build time in CI (optional locally).
NEXT_PUBLIC_BUILD_YEAR=

# Google Maps (optional). Enables the split search map view and mini-maps on
# listing cards (Maps JavaScript API + Static Maps API).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics (optional). Scripts load only on allow-listed hosts (defaults to
# the site hostname derived from NEXT_PUBLIC_SITE_ORIGIN). Put only the GTM
# container public ID (GTM-...) in GitHub Environment vars. Do not put GA4
# G- or Google Ads AW- IDs in git or build env — those live in GTM.
NEXT_PUBLIC_GTM_ID=
# Comma-separated hosts allowed to load gtm.js, e.g.
# siutindei.com,www.siutindei.com
NEXT_PUBLIC_GTM_ALLOWED_HOSTS=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ALLOWED_HOSTS=
