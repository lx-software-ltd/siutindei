{
  "name": "admin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../../docs/api/admin.yaml -o src/types/api-admin.generated.ts && openapi-typescript ../../docs/api/search.yaml -o src/types/api-search.generated.ts",
    "prebuild": "npm run generate:api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.2",
    "amazon-cognito-identity-js": "^6.3.20",
    "clsx": "^2.1.1",
    "currency-codes": "^2.2.0",
    "libphonenumber-js": "^1.13.13",
    "next": "^16.3.5",
    "nuqs": "^2.10.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "js-cookie": "^3.0.7"
  }
}
