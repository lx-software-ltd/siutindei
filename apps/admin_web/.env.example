NEXT_PUBLIC_API_BASE_URL=
# Same key as the public website. Catalog uses it for the neighbourhood map.
# Allowed websites must include https://siutindei.lx-software.com/* and
# http://localhost:3000/* or Google Maps refuses this admin host.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional. Advanced markers need a map id. Empty uses Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
