{
  "api-stack": "lxsoftware-siutindei",
  "also-api": ["PublicWwwOriginVerifySecret"],
  "routes": [
    {
      "stack": "lxsoftware-siutindei-admin-web",
      "parameters": ["AdminWebDomainName", "AdminWebCertificateArn", "WafWebAclArn"],
      "skip-empty": ["WafWebAclArn"]
    },
    {
      "stack": "lxsoftware-siutindei-public-www",
      "parameters": [
        "PublicWwwDomainName",
        "PublicWwwCertificateArn",
        "PublicWwwStagingDomainName",
        "PublicWwwStagingCertificateArn",
        "WafWebAclArn",
        "SearchApiProxyOriginDomain",
        "PublicWwwEdgeVerifySecret",
        "PublicWwwEdgeVerifySecretPrevious",
        "PublicWwwStagingEdgeVerifySecret",
        "PublicWwwStagingEdgeVerifySecretPrevious",
        "PublicWwwOriginVerifySecret"
      ]
    }
  ],
  "groups": [
    {
      "stacks": [
        "lxsoftware-siutindei",
        "lxsoftware-siutindei-admin-web",
        "lxsoftware-siutindei-public-www",
        "lxsoftware-siutindei-waf"
      ]
    }
  ]
}
